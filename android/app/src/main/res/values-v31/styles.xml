<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) launch theme: replaces the static system splash
         icon with the animated spinning-spoon vector. Background matches the
         app canvas so it blends into the Flutter splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_spoon_avd</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
