<?xml version="1.0" encoding="utf-8"?>
<!-- Shown until the app publishes a snapshot for today; also what a
     wiped profile falls back to. Shared by both widget layouts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calorie_widget_placeholder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:id="@+id/calorie_widget_placeholder_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/calorie_widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/calorie_widget_placeholder_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/calorie_widget_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
