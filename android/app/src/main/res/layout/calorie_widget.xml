<?xml version="1.0" encoding="utf-8"?>
<!-- The calorie widget. The provider shows exactly one body for the size
     it is given: the wide body (title, ring beside the macro rows), the
     narrow one (ring alone with the goal caption) or the compact one (the
     ring alone, whenever even the narrow body would clip); everything
     starts wide so the launcher preview shows the full widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calorie_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/calorie_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/calorie_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/calorie_widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Wide body: the ring beside the macro rows. -->
    <LinearLayout
        android:id="@+id/calorie_widget_body_wide"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp">

            <ProgressBar
                android:id="@+id/calorie_widget_ring_wide"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="10000"
                android:progressDrawable="@drawable/calorie_widget_ring" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/calorie_widget_consumed_wide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/calorie_widget_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calorie_widget_unit_wide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/calorie_widget_text_secondary"
                    android:textSize="11sp" />

                <!-- "of 2000": the goal, which the wide body otherwise
                     only implied through the ring. -->
                <TextView
                    android:id="@+id/calorie_widget_goal_wide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/calorie_widget_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/calorie_widget_row_protein"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <!-- Takes the width the figures leave, and ellipsizes a long
                     translated name rather than pushing them out. -->
                <TextView
                    android:id="@+id/calorie_widget_protein_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/calorie_widget_protein"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calorie_widget_protein_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/calorie_widget_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/calorie_widget_protein_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:gravity="end"
                    android:textColor="@color/calorie_widget_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/calorie_widget_row_carbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <!-- Takes the width the figures leave, and ellipsizes a long
                     translated name rather than pushing them out. -->
                <TextView
                    android:id="@+id/calorie_widget_carbs_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/calorie_widget_carbs"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calorie_widget_carbs_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/calorie_widget_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/calorie_widget_carbs_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:gravity="end"
                    android:textColor="@color/calorie_widget_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/calorie_widget_row_fat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <!-- Takes the width the figures leave, and ellipsizes a long
                     translated name rather than pushing them out. -->
                <TextView
                    android:id="@+id/calorie_widget_fat_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/calorie_widget_fat"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calorie_widget_fat_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/calorie_widget_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/calorie_widget_fat_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:gravity="end"
                    android:textColor="@color/calorie_widget_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Narrow body: the ring alone. -->
    <LinearLayout
        android:id="@+id/calorie_widget_body_narrow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp">

            <ProgressBar
                android:id="@+id/calorie_widget_ring_narrow"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="10000"
                android:progressDrawable="@drawable/calorie_widget_ring" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/calorie_widget_consumed_narrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/calorie_widget_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calorie_widget_unit_narrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/calorie_widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/calorie_widget_goal_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/calorie_widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Compact body: the granted span is shorter than the narrow body
         needs (about 133dp of content, plus the launcher's padding, while
         minHeight 110dp is the smallest cell span on offer). The 76dp ring
         in 24dp of padding fits anything down to the smallest resize, so
         nothing clips. -->
    <LinearLayout
        android:id="@+id/calorie_widget_body_compact"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp">

            <ProgressBar
                android:id="@+id/calorie_widget_ring_compact"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="10000"
                android:progressDrawable="@drawable/calorie_widget_ring" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/calorie_widget_consumed_compact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/calorie_widget_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calorie_widget_unit_compact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/calorie_widget_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Shown until the app publishes a snapshot for today; also what a
         wiped profile falls back to. -->
    <LinearLayout
        android:id="@+id/calorie_widget_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/calorie_widget_placeholder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/calorie_widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calorie_widget_placeholder_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/calorie_widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
