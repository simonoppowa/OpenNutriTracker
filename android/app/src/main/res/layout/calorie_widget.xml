<?xml version="1.0" encoding="utf-8"?>
<!-- The calorie widget. The provider shows exactly one body for the
     width it is given: the wide body (ring beside the macro rows) or the
     narrow one (ring alone); everything starts wide so the launcher
     preview shows the full widget. Below the height this layout needs,
     the provider uses calorie_widget_compact instead, which has the same
     views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calorie_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/calorie_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/calorie_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/calorie_widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Wide body: the ring beside the macro rows. -->
    <LinearLayout
        android:id="@+id/calorie_widget_body_wide"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp">

            <ProgressBar
                android:id="@+id/calorie_widget_ring_wide"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="10000"
                android:progressDrawable="@drawable/calorie_widget_ring" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/calorie_widget_consumed_wide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/calorie_widget_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calorie_widget_unit_wide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/calorie_widget_text_secondary"
                    android:textSize="11sp" />

                <!-- "of 2000": the goal, which the wide body otherwise
                     only implied through the ring. -->
                <TextView
                    android:id="@+id/calorie_widget_goal_wide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/calorie_widget_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <include layout="@layout/calorie_widget_macros" />
    </LinearLayout>

    <!-- Narrow body: the ring alone. -->
    <LinearLayout
        android:id="@+id/calorie_widget_body_narrow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp">

            <ProgressBar
                android:id="@+id/calorie_widget_ring_narrow"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="10000"
                android:progressDrawable="@drawable/calorie_widget_ring" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/calorie_widget_consumed_narrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/calorie_widget_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calorie_widget_unit_narrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/calorie_widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/calorie_widget_goal_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/calorie_widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <include layout="@layout/calorie_widget_placeholder" />
</LinearLayout>
